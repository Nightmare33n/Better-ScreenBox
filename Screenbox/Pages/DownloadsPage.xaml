<Page
    x:Class="Screenbox.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Screenbox.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:sbuc="using:Screenbox.UI.Controls"
    xmlns:strings="using:Screenbox.Strings"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Screenbox.Core.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid
            x:Name="HeaderGrid"
            Grid.Row="0"
            MinHeight="{StaticResource PageHeaderMinHeight}"
            Margin="{StaticResource BottomMediumMargin}"
            Padding="{StaticResource ContentPagePadding}"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource TitleMediumTextBlockStyle}"
                Text="{x:Bind strings:Resources.Downloads}" />
            <HyperlinkButton
                x:Name="EngineButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind strings:Resources.UpdateDownloadEngine}"
                Command="{x:Bind ViewModel.UpdateEngineCommand}"
                Content="{x:Bind helpers:DownloadLabelHelper.GetEngineText(ViewModel.Downloads.EngineVersion, ViewModel.Downloads.IsUpdatingEngine), Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind strings:Resources.UpdateDownloadEngine}"
                Visibility="{x:Bind helpers:DownloadLabelHelper.VisibleIfText(ViewModel.Downloads.EngineVersion), Mode=OneWay}" />
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.ClearFinishedCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="{StaticResource StandardIconFontSize}" Glyph="&#xE74D;" />
                    <TextBlock Text="{x:Bind strings:Resources.ClearFinishedDownloads}" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  Link input card  -->
        <Grid
            x:Name="InputCard"
            Grid.Row="1"
            Margin="{StaticResource ContentPagePadding}"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            ColumnSpacing="8"
            CornerRadius="{StaticResource OverlayCornerRadius}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox
                x:Name="LinkBox"
                Grid.Column="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind strings:Resources.DownloadsLinkPlaceholder}"
                InputScope="Url"
                IsEnabled="{x:Bind ViewModel.Downloads.IsSupported}"
                IsSpellCheckEnabled="False"
                KeyDown="LinkBox_OnKeyDown"
                PlaceholderText="{x:Bind strings:Resources.DownloadsLinkPlaceholder}"
                Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                x:Name="PasteButton"
                Grid.Column="1"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="{x:Bind strings:Resources.PasteLink}"
                Click="PasteButton_OnClick"
                IsEnabled="{x:Bind ViewModel.Downloads.IsSupported}"
                ToolTipService.ToolTip="{x:Bind strings:Resources.PasteLink}">
                <FontIcon FontSize="{StaticResource StandardIconFontSize}" Glyph="&#xE77F;" />
            </Button>
            <ComboBox
                x:Name="QualityBox"
                Grid.Column="2"
                MinWidth="168"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind strings:Resources.DownloadQualityHeader}"
                IsEnabled="{x:Bind ViewModel.Downloads.IsSupported}"
                SelectedIndex="{x:Bind ViewModel.SelectedQualityIndex, Mode=TwoWay}"
                ToolTipService.ToolTip="{x:Bind strings:Resources.DownloadQualityHeader}">
                <ComboBoxItem Content="{x:Bind strings:Resources.DownloadQualityBest}" />
                <ComboBoxItem Content="{x:Bind strings:Resources.DownloadQuality1080p}" />
                <ComboBoxItem Content="{x:Bind strings:Resources.DownloadQuality720p}" />
                <ComboBoxItem Content="{x:Bind strings:Resources.DownloadQuality480p}" />
                <ComboBoxItem Content="{x:Bind strings:Resources.DownloadQualityAudioOnly}" />
            </ComboBox>
            <Button
                x:Name="DownloadButton"
                Grid.Column="3"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.AddCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="{StaticResource StandardIconFontSize}" Glyph="&#xE896;" />
                    <TextBlock Text="{x:Bind strings:Resources.DownloadButton}" />
                </StackPanel>
            </Button>

            <TextBlock
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Margin="0,8,0,0"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind strings:Resources.DownloadsLinkInvalid}"
                Visibility="{x:Bind ViewModel.IsUrlInvalid, Mode=OneWay}" />
        </Grid>

        <!--  Problems that block downloading  -->
        <StackPanel
            x:Name="MessagesPanel"
            Grid.Row="2"
            Margin="{StaticResource ContentPagePadding}"
            Padding="0,8,0,0"
            Spacing="8">
            <muxc:InfoBar
                IsClosable="False"
                IsOpen="{x:Bind helpers:DownloadLabelHelper.Not(ViewModel.Downloads.IsSupported)}"
                Message="{x:Bind strings:Resources.DownloadsUnsupportedMessage}"
                Severity="Warning" />
            <muxc:InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.Downloads.HelperLaunchFailed, Mode=OneWay}"
                Message="{x:Bind strings:Resources.DownloadHelperLaunchFailed}"
                Severity="Error" />
            <muxc:InfoBar
                IsClosable="False"
                IsOpen="{x:Bind helpers:DownloadLabelHelper.HasText(ViewModel.Downloads.EngineError), Mode=OneWay}"
                Message="{x:Bind ViewModel.Downloads.EngineError, Mode=OneWay}"
                Severity="Error" />
        </StackPanel>

        <!--  Queue  -->
        <ListView
            x:Name="DownloadsList"
            Grid.Row="3"
            Padding="{x:Bind Common.FooterBottomPaddingMargin, Mode=OneWay}"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:DownloadItemViewModel">
                    <Grid
                        Margin="{StaticResource ContentPagePadding}"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ColumnSpacing="16"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Thumbnail  -->
                        <Border
                            Width="128"
                            Height="72"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                            <Grid>
                                <FontIcon
                                    FontSize="24"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE714;" />
                                <Image Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage
                                            DecodePixelType="Logical"
                                            DecodePixelWidth="128"
                                            UriSource="{x:Bind ThumbnailUri, Mode=OneWay}" />
                                    </Image.Source>
                                </Image>
                            </Grid>
                        </Border>

                        <!--  Text and progress  -->
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                MaxLines="2"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind helpers:DownloadLabelHelper.GetTitle(Title, SourceUrl), Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind helpers:DownloadLabelHelper.GetSubtitle(Channel, Collection, Duration), Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <muxc:ProgressBar
                                Margin="0,8,0,4"
                                IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                ShowError="{x:Bind IsFailed, Mode=OneWay}"
                                ShowPaused="{x:Bind CanRetry, Mode=OneWay}"
                                Visibility="{x:Bind helpers:DownloadLabelHelper.ProgressVisibility(State), Mode=OneWay}"
                                Value="{x:Bind ProgressPercent, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="{x:Bind IsFailed, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind helpers:DownloadLabelHelper.GetStatus(State, DownloadedBytes, TotalBytes, SpeedBytesPerSecond, Eta, Error), Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!--  Actions  -->
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                AutomationProperties.Name="{x:Bind strings:Resources.Play}"
                                Click="PlayButton_OnClick"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind strings:Resources.Play}"
                                Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                <FontIcon FontSize="{StaticResource StandardIconFontSize}" Glyph="&#xE768;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="{x:Bind strings:Resources.OpenFileLocation}"
                                Click="OpenFolderButton_OnClick"
                                ToolTipService.ToolTip="{x:Bind strings:Resources.OpenFileLocation}"
                                Visibility="{x:Bind IsCompleted, Mode=OneWay}">
                                <FontIcon FontSize="{StaticResource StandardIconFontSize}" Glyph="&#xE838;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="{x:Bind strings:Resources.RetryDownload}"
                                Click="RetryButton_OnClick"
                                ToolTipService.ToolTip="{x:Bind strings:Resources.RetryDownload}"
                                Visibility="{x:Bind CanRetry, Mode=OneWay}">
                                <FontIcon FontSize="{StaticResource StandardIconFontSize}" Glyph="&#xE72C;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="{x:Bind strings:Resources.CancelDownload}"
                                Click="CancelButton_OnClick"
                                ToolTipService.ToolTip="{x:Bind strings:Resources.CancelDownload}"
                                Visibility="{x:Bind CanCancel, Mode=OneWay}">
                                <FontIcon FontSize="{StaticResource StandardIconFontSize}" Glyph="&#xE711;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="{x:Bind strings:Resources.RemoveFromList}"
                                Click="RemoveButton_OnClick"
                                ToolTipService.ToolTip="{x:Bind strings:Resources.RemoveFromList}">
                                <FontIcon FontSize="{StaticResource StandardIconFontSize}" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Empty queue  -->
        <ScrollViewer
            x:Name="EmptyViewer"
            Grid.Row="3"
            Padding="{StaticResource ContentPagePadding}"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind helpers:DownloadLabelHelper.CollapsedIf(ViewModel.HasItems), Mode=OneWay}">
            <sbuc:ContentUnavailableView
                x:Name="EmptyPanel"
                Title="{x:Bind strings:Resources.DownloadsEmptyHeader}"
                IsOpen="True"
                Message="{x:Bind strings:Resources.DownloadsEmptyMessage}">
                <FontIcon
                    x:Name="EmptyPanelIcon"
                    Margin="0,0,16,0"
                    FontSize="{StaticResource NoContentPanelIconFontSize}"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE896;" />
            </sbuc:ContentUnavailableView>
        </ScrollViewer>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="NavigationViewStates">
                <VisualState x:Name="Expanded" />
                <VisualState x:Name="Compact" />
                <VisualState x:Name="Minimal">
                    <VisualState.StateTriggers>
                        <ui:IsEqualStateTrigger Value="{x:Bind Common.NavigationViewDisplayMode, Mode=OneWay}" To="{StaticResource MinimalNavigationViewDisplayMode}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderGrid.Padding" Value="{StaticResource ContentPageMinimalPadding}" />
                        <Setter Target="InputCard.Margin" Value="{StaticResource ContentPageMinimalPadding}" />
                        <Setter Target="MessagesPanel.Margin" Value="{StaticResource ContentPageMinimalPadding}" />
                        <Setter Target="EmptyViewer.Padding" Value="{StaticResource ContentPageMinimalPadding}" />
                        <Setter Target="EmptyPanelIcon.Margin" Value="0,0,0,0" />
                        <Setter Target="EmptyPanelIcon.FontSize" Value="{StaticResource NoContentPanelMinimalIconFontSize}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  Quality and Download move under the link box on narrow windows.  -->
                        <Setter Target="QualityBox.(Grid.Row)" Value="1" />
                        <Setter Target="QualityBox.(Grid.Column)" Value="0" />
                        <Setter Target="QualityBox.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="QualityBox.Margin" Value="0,8,0,0" />
                        <Setter Target="DownloadButton.Margin" Value="0,8,0,0" />
                        <Setter Target="DownloadButton.(Grid.Row)" Value="1" />
                        <Setter Target="DownloadButton.(Grid.Column)" Value="1" />
                        <Setter Target="DownloadButton.(Grid.ColumnSpan)" Value="3" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
